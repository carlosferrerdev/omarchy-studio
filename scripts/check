#!/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
for dependency in shellcheck shfmt jq python3 node; do
  command -v "$dependency" >/dev/null || {
    printf 'Missing development dependency: %s\n' "$dependency" >&2
    exit 3
  }
done
mapfile -t shell_files < <(printf '%s\n' bin/omarchy-studio lib/*/*.sh scripts/check tests/run tests/qml-smoke tests/*.sh)
for file in "${shell_files[@]}"; do bash -n "$file"; done
shellcheck -x "${shell_files[@]}"
shfmt -d -i 2 -ci "${shell_files[@]}"
./tests/run
./tests/audio-defaults.sh
python3 tests/validate-schema.py
node tests/plugin-model.cjs
version=$(./bin/omarchy-studio version --json | jq -r '.version')
jq -e --arg version "$version" '.schemaVersion == 1 and .id == "io.github.carlosferrerdev.omarchy-studio" and .version == $version and .name == "Omarchy Studio" and .kinds == ["bar-widget"] and .entryPoints.barWidget == "plugin/BarWidget.qml" and .barWidget.allowMultiple == false and .barWidget.defaultSection == "right"' manifest.json >/dev/null
[[ -f plugin/BarWidget.qml ]]
if command -v omarchy >/dev/null; then omarchy plugin validate "$root"; fi
git diff --check
printf 'All foundation checks passed.\n'
